# DB (Postgres local en docker: `docker start trip-postgres`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripguide

# Firma de la cookie de sesión. Obligatoria en producción (lib/session.ts tira
# si falta); en dev cae a un secreto fijo.
SESSION_SECRET=dev-only-secret

# Contraseñas válidas del login, separadas por comas. Más de una a la vez para
# poder rotar sin cortarle el acceso a nadie. Vacío => no entra nadie.
# Comillar el valor si alguna contraseña tiene "#": dotenv corta ahí.
LOGIN_PASSWORDS="dev-password"

# Integración con Spitwise (misma key en los dos servicios)
TRIP_SHARED_API_KEY=change-me-shared-key
SPITWISE_URL=http://localhost:8000

# Demo pública (demo.andiamo.lat). En prod NEXT_PUBLIC_DEMO_URL es el CTA de
# /login; en el propio deploy de demo se prende NEXT_PUBLIC_DEMO_MODE=1 (que
# saltea el gate) y NEXT_PUBLIC_DEMO_TODAY congela el "hoy" del itinerario.
NEXT_PUBLIC_DEMO_URL=https://demo.andiamo.lat
# NEXT_PUBLIC_DEMO_MODE=1
# NEXT_PUBLIC_DEMO_TODAY=2026-09-25

# Storage de documentos (Cloudflare R2). Sin esto, subir archivos falla; los
# documentos por link siguen andando.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
