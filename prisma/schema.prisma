generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stop {
  id            String     @id @default(cuid())
  order         Int        @unique
  country       String
  countryFlag   String
  name          String
  slug          String     @unique
  category      String
  priceLevel    String
  arrivalDate   DateTime? @db.Date
  departureDate DateTime? @db.Date
  nights        Int        @default(0)
  latitude      Float
  longitude     Float
  timezone      String?
  currencyCode  String
  tempRange     String?
  isCandidate   Boolean    @default(false)
  isFlexMargin  Boolean    @default(false)
  /// Fixed date: the itinerary walk *jumps* the cursor to this stop's
  /// arrivalDate instead of deriving it from the previous stop's departure.
  /// This is what lets the itinerary hold a gap (the unbooked days between
  /// Nápoles and Barcelona) and what protects a stop with a bought ticket from
  /// being dragged by an edit upstream of it. See computeItinerary.
  isAnchored    Boolean    @default(false)
  /// Who this stop belongs to. null = shared (default, every stop today).
  /// A person value ("bruno"/"katia") makes it a *person-scoped* stop: visible
  /// only to that viewer (and to "Ambos"), hidden from the other. See Pititas.
  ownerPerson   String?
  /// Pseudo-city that exists only in Andiamo's per-person view: no flag/sun/
  /// weather/temp/currency, and excluded from the /api/stops sync to Spitwise.
  isLocal       Boolean    @default(false)
  notes         Note[]
  documents     Document[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  stopId    String?
  stop      Stop?    @relation(fields: [stopId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stopId])
}

model Document {
  id          String       @id @default(cuid())
  stopId      String?
  stop        Stop?        @relation(fields: [stopId], references: [id], onDelete: Cascade)
  label       String
  note        String?
  kind        DocumentKind @default(other)
  source      String
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  storagePath String?
  externalUrl String?
  docDate     DateTime?    @db.Date
  createdAt   DateTime     @default(now())

  @@index([stopId])
}

enum DocumentKind {
  checkin
  voucher
  ticket
  carRental
  train
  insurance
  flight
  other
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
